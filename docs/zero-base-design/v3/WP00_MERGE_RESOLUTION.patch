+
+export const DEMO_NATIVE_CANONICAL_FIXTURE_CONTRACT_VERSION =
+  "adsecute.demo-native-canonical-fixture.v1" as const;
+
+export interface DemoNativeCanonicalFixtureItem {
+  adId: string;
