# Credential-free environment for the zero-base local production smoke.
#
# This file is committed on purpose and MUST NEVER hold a real secret, host,
# token or connection string. The smoke it serves proves one thing: that the
# production build boots and serves its public surfaces. That question has no
# credential in it, so answering it must not require one — a release gate that
# only runs on a machine with a personal `.env.local` is a gate CI cannot hold.
#
# Anything reached through these values is unreachable by construction: the
# database host does not resolve, and no provider id is real. A smoke that
# needs more than this is asking a question the smoke is not for.
NODE_ENV=production
PORT=3100
HOSTNAME=127.0.0.1
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
ALLOW_INSECURE_LOCAL_AUTH_COOKIE=1

# Unroutable by design. `.invalid` is reserved by RFC 2606 and never resolves.
DATABASE_URL=postgres://smoke:smoke@db.invalid:5432/smoke
DATABASE_URL_UNPOOLED=postgres://smoke:smoke@db.invalid:5432/smoke

# Present so startup validation has a shape to check, and worthless as a secret.
CRON_SECRET=zero-base-local-production-smoke-not-a-secret
