+
+const REQUIRED_AUTHORITY_SOURCE_FILES = [
+  "scripts/creative-decision-center/native-ad-account-aov-authority-replay.ts",
+  "scripts/_operational-runtime.ts",
+  "lib/creative-decision-engine/jobs/ad-decisions-job.ts",
