+        landingPageViews: scalar(row.landing_page_views),
+        addToCart: scalar(row.add_to_cart),
+        initiateCheckout: scalar(row.initiate_checkout),
+        ctrAll: scalar(row.ctr_all),
+        frequency: scalar(row.frequency),
