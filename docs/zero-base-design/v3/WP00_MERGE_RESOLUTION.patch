+        metadataInteger(metadata, "episodes_captured") !== episodesCaptured ||
+        metadataInteger(metadata, "episodes_evaluated") !==
+          episodesEvaluated ||
+        metadataInteger(metadata, "evidence_events_written") !==
+          evidenceEvents ||
