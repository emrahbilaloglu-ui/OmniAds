+  const challengerTuple = decisionProjectionTuple({
+    ...input.challenger,
+    authorizedAction: input.challenger.simulatedAuthorizedAction,
+  });
+  if (canonicalSha256(baselineTuple) === canonicalSha256(challengerTuple)) {
+    return "identical";
