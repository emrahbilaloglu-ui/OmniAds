+    if (!isObject(current)) return null;
+    current = current[key];
+  }
+  return isObject(current) ? current : null;
+}
+
+function arrayAt(value: unknown, ...path: string[]): unknown[] | null {
+  let current = value;
+  for (const key of path) {
+    if (!isObject(current)) return null;
+    current = current[key];
+  }
+  return Array.isArray(current) ? current : null;
