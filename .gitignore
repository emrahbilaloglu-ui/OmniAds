# Read-only replay row data can contain customer identifiers and exceed GitHub's
# file limit. Keep the reproducible scripts and sanitized Markdown summaries.
/docs/creative-decision-center/generated/exact-pit-confirmatory-replay-*.json
/docs/creative-decision-center/generated/native-ad-grain-paired-replay-*.json
/docs/creative-decision-center/generated/native-structure-grain-paired-replay-*.json
/docs/creative-decision-center/generated/h1-country-parent-challenger-*.json
/docs/creative-decision-center/generated/h11-campaign-context-challenger-*.json
/docs/creative-decision-center/generated/h12-decision-hysteresis-challenger-*.json

# Transient Playwright smoke output. Kept evidence lives in dated subdirectories
# (e.g. playwright-smoke-artifacts/<name>-<date>/), which stay tracked; these two
# paths are rewritten by every run and must not accumulate in the tree.
/docs/full-ui-redesign/playwright-smoke-artifacts/html-report/
/docs/full-ui-redesign/playwright-smoke-artifacts/test-results/
playwright/.harness/
