+function exactStringArray(
+  value: unknown,
+  expected: readonly string[],
+) {
+  return (
+    Array.isArray(value) &&
+    value.length === expected.length &&
+    value.every(
+      (item, index) =>
+        typeof item === "string" && item === expected[index],
+    )
