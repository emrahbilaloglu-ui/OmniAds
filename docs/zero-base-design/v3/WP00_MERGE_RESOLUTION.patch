+type NativeSchemaCapability = {
+  ready: boolean;
+  missing?: readonly string[];
+  mismatched?: readonly string[];
+  issues?: readonly string[];
+};
+
+function nativeSchemaIssues(capability: NativeSchemaCapability) {
+  return [
+    ...(capability.missing ?? []),
+    ...(capability.mismatched ?? []),
