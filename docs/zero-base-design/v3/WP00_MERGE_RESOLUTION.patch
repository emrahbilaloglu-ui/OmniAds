+          (event) =>
+            event.episodeKey === response.episodeKey &&
+            timestampMs(event.responseCutoff) ===
+              timestampMs(response.responseCutoff),
+        );
+        if (
+          !operatorResponseProofValid(
+            response,
+            episodesByKey.get(response.episodeKey),
+            responseEvents,
+          )
+        ) {
+          operatorHashOrLineageInvalid = true;
+        }
+      }
