+function parseRoasDisplay(value: string): number | null {
+  const match = value
+    .trim()
+    .replace(",", ".")
+    .match(/-?\d+(?:\.\d+)?/);
+  if (!match) return null;
+  const parsed = Number(match[0]);
+  return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
+}
