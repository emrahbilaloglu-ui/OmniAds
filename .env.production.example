# Deploy notes
# APP_IMAGE_TAG and APP_BUILD_ID are set by the deploy workflow per exact commit SHA.
# Keep runtime secrets in this file; do not pin image tags here.
#
# Core runtime
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=https://your-domain.com
CRON_SECRET=replace-with-a-long-random-secret

# Database
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_PGDATABASE=
DATABASE_PGHOST=
DATABASE_PGHOST_UNPOOLED=
DATABASE_PGPASSWORD=
DATABASE_PGUSER=
DATABASE_POSTGRES_DATABASE=
DATABASE_POSTGRES_HOST=
DATABASE_POSTGRES_PASSWORD=
DATABASE_POSTGRES_PRISMA_URL=
DATABASE_POSTGRES_URL=
DATABASE_POSTGRES_URL_NON_POOLING=
DATABASE_POSTGRES_URL_NO_SSL=
DATABASE_POSTGRES_USER=
# Connection-level guards (recommended). Without these only per-query timeouts on
# the pooled path apply; setting them bounds every connection/path so a slow or
# idle-in-transaction session cannot pin a worker connection indefinitely.
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# Meta / Facebook
META_APP_ID=
META_APP_SECRET=
SIGN_WITH_FACEBOOK_REDIRECT_URI=https://your-domain.com/api/oauth/sign-with-facebook/callback

# Google Ads / Google Sign-In / Analytics / Search Console
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_PROJECT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=https://your-domain.com/api/oauth/google/callback
GOOGLE_ADS_SCOPES=
GOOGLE_ADS_AUTH_URI=
GOOGLE_ADS_TOKEN_URI=
GOOGLE_ADS_AUTH_PROVIDER_X509_CERT_URL=
GOOGLE_ANALYTICS_REDIRECT_URI=https://your-domain.com/api/oauth/google-analytics/callback
GOOGLE_ANALYTICS_SCOPES=
SIGN_WITH_GOOGLE_PROJECT_ID=
SIGN_WITH_GOOGLE_CLIENT_ID=
SIGN_WITH_GOOGLE_CLIENT_SECRET=
SIGN_WITH_GOOGLE_REDIRECT_URI=https://your-domain.com/api/oauth/sign-with-google/callback
SIGN_WITH_GOOGLE_SCOPES=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_EXTENDED_CANARY_BUSINESS_IDS=

# Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_all_orders,read_analytics,read_customer_events,read_customers,read_discounts,read_fulfillments,read_inventory,read_locations,read_marketing_events,read_markets,read_online_store_pages,read_orders,read_price_rules,read_product_listings,read_products,read_reports,read_returns,write_pixels
SHOPIFY_APP_URL=https://your-domain.com
SHOPIFY_REDIRECT_URI=https://your-domain.com/api/oauth/shopify/callback

# OpenAI
OPENAI_API_KEY=

# Runtime migrations / worker tuning
ENABLE_RUNTIME_MIGRATIONS=0
META_TODAY_LIVE_READS_ENABLED=true
GOOGLE_ADS_TODAY_LIVE_READS_ENABLED=true
META_AUTHORITATIVE_FINALIZATION_V2=1
META_RETENTION_EXECUTION_ENABLED=0

# Creative Decision Engine v3 rollout flags.
# Per-business rows in business_engine_v3_flags can override these; NULL means inherit env.
# Rollout default / shadow mode: enabled=true, surfaceVisible=false, shadowOnly=true.
# Preview mode: enabled=true, surfaceVisible=true, shadowOnly=true.
# Live mode: enabled=true, surfaceVisible=true, shadowOnly=false.
# Global kill switch: enabled=false (jobs and API skip v3 for inherited businesses).
DECISION_ENGINE_V3_ENABLED=true
DECISION_ENGINE_V3_SURFACE_VISIBLE=true
DECISION_ENGINE_V3_SHADOW_ONLY=false

SYNC_DEPLOY_GATE_MODE=block
SYNC_RELEASE_GATE_MODE=block
SYNC_RELEASE_CANARY_BUSINESSES=172d0ab8-495b-4679-a4c6-ffa404c389d3,5dbc7147-f051-4681-a4d6-20617170074f,f8a3b5ac-588c-462f-8702-11cd24ff3cd2
WORKER_INSTANCE_ID=
WORKER_POLL_INTERVAL_MS=10000
WORKER_MAX_BUSINESSES_PER_TICK=50
WORKER_RUNNER_LEASE_MINUTES=2
WORKER_HEARTBEAT_INTERVAL_MS=15000
# Self-heal watchdog: if the worker writes no heartbeat for this long the process
# force-exits so the container restart policy brings up a fresh worker. Must stay
# above the slowest legitimate gap between heartbeats (heavy ticks / maintenance).
WORKER_STALL_EXIT_MS=300000
WORKER_GLOBAL_DB_CONCURRENCY=4
WORKER_PRUNE_INTERVAL_MS=21600000
GOOGLE_ADS_WORKER_CONCURRENCY=1
META_WORKER_CONCURRENCY=1
GOOGLE_ADS_DEBUG_PRIORITY_BUSINESS_IDS=

# ── Global sync kill switch ───────────────────────────────────────────────────
# Every lane defaults to OFF. Nothing needs to be set to STOP writing; something
# must be set to START. The master switch is deliberately not a blanket grant —
# each lane is enabled explicitly, so resuming sync cannot resume retention.
# Only the exact value "enabled" admits; a typo reads as disabled.
# See docs/global-sync-rollout-runbook.md.
ADSECUTE_SYNC_GLOBAL_ENABLED=
ADSECUTE_SYNC_LANE_META_SYNC_ENABLED=
ADSECUTE_SYNC_LANE_GOOGLE_SYNC_ENABLED=
ADSECUTE_SYNC_LANE_SHOPIFY_SYNC_ENABLED=
# GA4, Search Console and any other non-Ads external-source ingest.
ADSECUTE_SYNC_LANE_SOURCE_INGEST_ENABLED=
ADSECUTE_SYNC_LANE_CRON_ENQUEUE_ENABLED=
ADSECUTE_SYNC_LANE_ASSIGNMENT_MUTATION_ENABLED=
# Retention is the only path that deletes. It stays unset until its first
# production run is argued for separately.
ADSECUTE_SYNC_LANE_RETENTION_ENABLED=

# Filesystem headroom for the PostgreSQL data volume, measured ON THE DATABASE
# HOST and supplied here. The application cannot see that filesystem, so without
# these the growth fence reports volume headroom as "unknown" rather than
# implying the logical budget proves disk space.
SYNC_GROWTH_FENCE_VOLUME_AVAILABLE_BYTES=
SYNC_GROWTH_FENCE_VOLUME_CAPACITY_BYTES=

# Aggregate database budget override. The default is 160 GiB, derived in
# lib/sync/db-growth-fence.ts from the live measurement, the volume, and the
# 40 GiB host free-space floor. Do not raise it to silence a warning: the
# warning band is the only notice before refusal.
SYNC_GROWTH_FENCE_DATABASE_BYTES=

# Bounded lock wait for DDL. A migration statement that blocks behind a
# long-running reader would otherwise queue every request behind it.
MIGRATION_LOCK_TIMEOUT_MS=15000
