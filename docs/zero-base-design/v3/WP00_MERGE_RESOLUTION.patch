+          batch.providerAccountId === accountId &&
+          batch.asOf === args.asOf &&
+          batch.engineVersion === NATIVE_AD_ENGINE_VERSION &&
+          batch.policyVersion === NATIVE_AD_CALIBRATION_POLICY_VERSION &&
