+const REPLAY_DATA_HEALTH: DataHealth = {
+  calibration: {
+    asOfDate: null,
+    computedAt: null,
+    sourceFreshnessHours: 0,
+    staleTier: "none",
+    fallbackMode: "precomputed",
+    note: "D061 paired fixed-input restated replay",
+  },
+  lifecycle: {
